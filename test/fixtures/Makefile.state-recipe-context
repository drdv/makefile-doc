# Which lines keep or end the recipe context (`make help` relies on it: a tab-indented
# ## line is a recipe line inside a rule, and a doc outside one). Each block is
#   a context: a documented rule with a recipe (inside a rule) or an assignment (outside)
#   the line under test
#   a tab-indented doc
#   a target, next-N: documented only if the line under test leaves the parser outside
#   a rule (as in GNU Make)
# More lines that start or end the recipe context are in Makefile.state-recipe-start and
# Makefile.state-recipe-end.

SRCS := s.c

## Doc of rule-1
rule-1:
	@echo rule-1
x-1: dep
	## a plain rule, after a rule
next-1:

## Doc of rule-2
rule-2:
	@echo rule-2
x-2::
	## a double-colon rule, after a rule
next-2:

## Doc of rule-3
rule-3:
	@echo rule-3
x1-3 x2-3 &: dep
	## grouped targets, after a rule
next-3:

## Doc of rule-4
