#: desc: The parser state after each line of Makefile.targets-forms
#: trace
test/fixtures/Makefile.targets-forms
#: stdout
== test/fixtures/Makefile.targets-forms
   1 0 1  0  0 \t | %.tab.c %.tab.h: %.y: ## A pattern rule
   1 ============ => target:[%.tab.c %.tab.h]
   2 0 1  0  0 \t |
   3 0 1  0  0 \t | %.c: ## Another pattern rule
   3 ============ => target:[%.c]
   4 0 1  0  0 \t |
   5 0 1  0  0 \t | bin/%.o: %.c ## A pattern rule with a prerequisite
   5 ============ => target:[bin/%.o]
   6 0 1  0  0 \t |
   7 0 1  1  0 \t | ## Three targets on one line (separated by several spaces)
   8 0 1  0  0 \t | first    second third:
   8 ============ => target:[first second third]
   9 0 1  0  0 \t |
  10 0 1  1  0 \t | ## Target with spaces before and after
  11 0 1  0  0 \t |   t1  :
  11 ============ => target:[t1]
  12 0 1  0  0 \t |
  13 0 1  0  0 \t | $(TARGET-NAME): ## Target from a variable in `$()`
  13 ============ => target:[$(TARGET-NAME)]
  14 0 1  0  0 \t |
  15 0 1  0  0 \t | ${TARGET-NAME}: ## Target from a variable in `${}`
  15 ============ => target:[${TARGET-NAME}]
  16 0 1  0  0 \t |
  17 0 1  0  0 \t | $T: ## Target from a one-letter variable
  17 ============ => target:[$T]
  18 0 1  0  0 \t |
  19 0 1  0  0 \t | # t3 here is not treated separately and does not get its own docs
  20 0 1  0  0 \t | $(t1) ${t2} t3: ## Variables and a name (issue #12)
  20 ============ => target:[$(t1) ${t2} t3]
  21 0 1  0  0 \t |
  22 0 1  1  0 \t | ## Targets with an = among them (two words before it: not an assignment)
  23 0 1  0  0 \t | a b = c: d
  23 ============ => target:[a b = c]
