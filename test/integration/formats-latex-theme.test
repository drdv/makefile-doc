-v OUTPUT_FORMAT=latex -v COLOR_ATTENTION=1 -v COLOR_SECTION=3 -v COLOR_DEPRECATED=4 -v COLOR_BACKTICKS=9 -v EXPORT_THEME=FG:000000,BG:AAAAAA,34:7c3f00 test/fixtures/Makefile.formats
#: stdout
\documentclass{article}
\usepackage{iftex}
\ifPDFTeX
  \usepackage[T1]{fontenc}
  \usepackage{lmodern}
\else
  \usepackage{fontspec}
\fi
\usepackage{xcolor}
\usepackage{alltt}
\usepackage[top=0cm, bottom=0cm, left=0cm, right=0cm]{geometry}
\usepackage{varwidth}
\usepackage[active,tightpage]{preview}
\usepackage[normalem]{ulem}

\setlength{\fboxsep}{0pt}

\newcommand{\bgcolor}[2]{\colorbox{#1}{\vphantom{Ay}#2}}

\PreviewEnvironment{varwidth}

\definecolor{makefile-doc-fg}{HTML}{000000}
\definecolor{makefile-doc-bg}{HTML}{AAAAAA}
\definecolor{makefile-doc-attention}{HTML}{000000}
\definecolor{makefile-doc-section}{HTML}{000000}
\definecolor{makefile-doc-deprecated}{HTML}{000000}
\definecolor{makefile-doc-default}{HTML}{7c3f00}
\definecolor{makefile-doc-backticks}{HTML}{000000}

\pagestyle{empty}
\begin{document}

\begin{varwidth}{\linewidth}
\pagecolor{makefile-doc-bg}

\begin{alltt}
\textcolor{makefile-doc-fg}{------------------}
\textcolor{makefile-doc-fg}{Available targets:}
\textcolor{makefile-doc-fg}{------------------}

\textcolor{makefile-doc-fg}{\emph{Section with \sout{backticks} and \{braces\}}}

\textcolor{makefile-doc-fg}{\textcolor{makefile-doc-default}{t-default   }   A default target with \sout{backticks} and \{braces\}}
\textcolor{makefile-doc-fg}{               on two lines}
\textcolor{makefile-doc-fg}{\textbf{t-attention }   An attention target}
\textcolor{makefile-doc-fg}{\uline{t-deprecated}   A deprecated target}

\textcolor{makefile-doc-fg}{------------------}
\textcolor{makefile-doc-fg}{Variables:}
\textcolor{makefile-doc-fg}{------------------}
\textcolor{makefile-doc-fg}{\textcolor{makefile-doc-default}{VAR         }   A variable}
\textcolor{makefile-doc-fg}{------------------}
\end{alltt}
\end{varwidth}
\end{document}
