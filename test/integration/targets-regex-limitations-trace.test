== test/fixtures/Makefile.targets-regex-limitations
   1 0 0  1  0 \t | ## Escaped #
   2 0 0  0  0 \t | foo\#bar:
   3 0 0  0  0 \t |
   4 0 0  1  0 \t | ## Escaped :
