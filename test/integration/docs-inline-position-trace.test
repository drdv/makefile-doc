#: desc: The parser state after each line of Makefile.docs-inline-position
#: trace
test/fixtures/Makefile.docs-inline-position
#: stdout
== test/fixtures/Makefile.docs-inline-position
   1 . R   0  0 | t1: t0 ## Inline docs after prerequisites
   1 ========== => target:t1
   2 . R   0  0 |
   3 . R   0  0 | t2: t0 | t1 ## Inline docs after order-only prerequisites
   3 ========== => target:t2
   4 . R   0  0 |
   5 . R   0  0 | t3: A:=1 ## Inline docs after a target-specific variable
   5 ========== => target:t3
   6 . R   0  0 |
   7 . R   0  0 | t4:## No space needed
   7 ========== => target:t4
   8 . R   0  0 | t5: A:=1## No space needed after a target-specific variable
   8 ========== => target:t5
   9 . R   0  0 | t6: this that## No space needed after prerequisites
   9 ========== => target:t6
  10 . R   0  0 |
  11 . R   0  0 | # a comment after an inline recipe is not Makefile syntax
  12 . R   0  0 | t-no-docs:; echo 1 ## Cannot have docs here
  13 . R   0  0 | t-no-docs:; ## Neither here
  14 . R   0  0 |
  15 . R   1  0 | ## Top docs can be used when there is an inline recipe
  16 . R   0  0 | t7:; echo 1
  16 ========== => target:t7
  17 . R   0  0 |
  18 . R   1  0 | ## Also with prerequisites before the inline recipe
  19 . R   0  0 | t8: t0; echo 1
  19 ========== => target:t8
  20 . R   0  0 |
  21 . R   0  0 | t-no-docs-section: ##@ An inline section token is not a doc
  22 . R   0  0 |
  23 . R   0  0 | # for Make, the comment starts at the first #: a ## later in it is not a doc
  24 . R   0  0 | t-no-docs-comment: t0 # an ordinary comment ## is not a doc
  25 . -   0  0 | V_NO_DOCS := 1 # an ordinary comment ## is not a doc
  26 . -   0  0 |
  27 . R   0  0 | t9: ## A ## in the doc is kept
  27 ========== => target:t9
  28 . -   0  0 | V := a\#b ## Inline docs after an escaped \# in the value
  28 ========== => variable:V
