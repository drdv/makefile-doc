#: desc: The parser state after each line of Makefile.targets-directives
#: trace
test/fixtures/Makefile.targets-directives
#: stdout
== test/fixtures/Makefile.targets-directives
   1 0 0  1  0 \t | ## Docs are kept above a conditional with a colon (quoted form)
   2 0 0  1  0 \t | ifeq "$(OS)" "a:b"
   3 0 1  0  0 \t | t1:
   3 ============ => target:[t1]
   4 0 1  0  0 \t | endif
   5 0 1  0  0 \t |
   6 0 1  1  0 \t | ## Docs are kept above a conditional with a colon (parenthesized form)
   7 0 1  1  0 \t | ifeq (a:b,c)
   8 0 1  0  0 \t | t2:
   8 ============ => target:[t2]
   9 0 1  0  0 \t | else ifneq (c:d,e)
  10 0 1  0  0 \t | endif
  11 0 1  0  0 \t |
  12 0 1  1  0 \t | ## These docs are discarded by vpath
  13 0 1  0  0 \t | vpath %.c src:lib
  14 0 1  0  0 \t | t3: ## vpath with a colon is not a target
  14 ============ => target:[t3]
  15 0 1  0  0 \t |
  16 0 1  1  0 \t | ## These docs are discarded by include
  17 0 1  0  0 \t | include a:b
  18 0 1  0  0 \t | -include c:d
  19 0 1  0  0 \t | sinclude e:f
  20 0 1  0  0 \t | t4: ## include with a colon is not a target
  20 ============ => target:[t4]
  21 0 1  0  0 \t |
  22 0 1  1  0 \t | ## These docs are discarded by export
  23 0 1  0  0 \t | export A:B
  24 0 1  0  0 \t | t5: ## export without an assignment is not a target
  24 ============ => target:[t5]
  25 0 1  0  0 \t |
  26 0 1  1  0 \t | ## A variable named as a directive is a variable
  27 0 0  0  0 \t | include := a:b
  27 ============ => variable:[include]
  28 0 0  0  0 \t |
  29 0 0  1  0 \t | ## A target that starts with the name of a directive is a target
  30 0 1  0  0 \t | include-all: a:b
  30 ============ => target:[include-all]
