#: desc: The parser state after each line of the multi-file fixtures, read together (the state carried over between files)
#: trace
test/fixtures/Makefile.multi-file test/fixtures/Makefile.multi-file.2 test/fixtures/Makefile.multi-file.3 test/fixtures/Makefile.multi-file.4 test/fixtures/Makefile.multi-file.5 test/fixtures/Makefile.multi-file.6
#: stdout
== test/fixtures/Makefile.multi-file
   1 0 1  0  0 \t | first: ## the first target
   1 ============ => target:first
   2 0 1  0  0 \t |
   3 0 1  1  0 \t | ## a doc at the end of a file is not carried over to the next file
== test/fixtures/Makefile.multi-file.2
   1 0 1  0  0 \t | after-doc: ## not documented with the dangling doc of the previous file
   1 ============ => target:after-doc
   2 0 1  0  0 \t |
   3 0 1  0  0 \t | ends-in-recipe:
   4 1 1  0  0 \t | \t@echo a continued recipe line at the end of the file \
== test/fixtures/Makefile.multi-file.3
   1 0 1  0  0 \t | after-recipe: ## not swallowed as a recipe continuation
   1 ============ => target:after-recipe
   2 0 1  0  0 \t |
   3 0 1  0  0 \t | ends-in-rule:
== test/fixtures/Makefile.multi-file.4
   1 0 1  0  0 \t | \tafter-rule: ## not a recipe line of the last rule of the previous file
   1 ============ => target:after-rule
   2 0 1  0  0 \t |
   3 1 1  0  0 \t | # a continued comment at the end of the file \
== test/fixtures/Makefile.multi-file.5
   1 0 1  0  0 \t | after-comment: ## not swallowed as a comment continuation
   1 ============ => target:after-comment
   2 0 1  0  0 \t |
   3 1 1  0  0 \t | ends-in-continued-line: \
== test/fixtures/Makefile.multi-file.6
   1 0 1  0  0 \t | after-continued-line: ## not joined with the last line of the previous file
   1 ============ => target:after-continued-line
