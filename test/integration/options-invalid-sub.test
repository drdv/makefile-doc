#: desc: Invalid items and parameters (also repeated ones) of SUB and DSUB are reported
-v COLOR=0 -v SUB='t;:v;<Z:1,L:2,M:x,N:-2,S:x>t:v;<L:0,M:1,N:-1>V:v;<L:0,L:1>W:v' -v DSUB='no-colon;:v;<Z:1,A:2>x:v;<D:0>y:v;<A:1,D:0>z:v;<A:1,A:1>w:v' test/fixtures/Makefile.options
#: stderr
makefile-doc: error: SUB: 't' should be NAME:[[LABEL]:][VALUES]
makefile-doc: error: SUB: ':v' has an empty NAME
makefile-doc: error: SUB: unknown parameter Z of t (use L, M, N, S, P, I or T)
makefile-doc: error: SUB: parameter L of t should be 0 or 1
makefile-doc: error: SUB: parameter M of t should be 0 or 1
makefile-doc: error: SUB: parameter N of t should be -1 or a non-negative integer
makefile-doc: error: SUB: parameter L of W is given more than once
makefile-doc: error: DSUB: 'no-colon' should be NAME:VALUE
makefile-doc: error: DSUB: ':v' has an empty NAME
makefile-doc: error: DSUB: unknown parameter Z of x (use A or D)
makefile-doc: error: DSUB: parameter A of x should be 0 or 1
makefile-doc: error: DSUB: y is replaced nowhere (A and D are both 0)
makefile-doc: error: DSUB: parameter A of w is given more than once
#: exit: 1
